{
  "name": "@dayhome/directory",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "drizzle": "drizzle-kit",
    "data:load": "tsx ./data/load.ts",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "tsc": "tsc",
    "check": "pnpm lint && pnpm tsc && pnpm fmt:check && pnpm build",
    "ci": "pnpm check",
    "db:up": "docker compose -f ../../docker-compose.yml up -d --wait postgres",
    "db:status": "docker compose -f ../../docker-compose.yml ps --format 'table {{.Service}}\t{{.Status}}\t{{.Ports}}'",
    "db:down": "docker compose -f ../../docker-compose.yml down",
    "db:seed": "tsx scripts/seed_db/main.ts",
    "auth:gen-schema": "pnpx @better-auth/cli generate --config ./src/lib/auth/better_auth.ts --output ./src/lib/auth/auth_schema.gen.ts"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.50.0",
    "@dayhome/auth": "workspace:*",
    "@dayhome/core": "workspace:*",
    "@dayhome/ui": "workspace:*",
    "@mapbox/search-js-core": "^1.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-form": "^1.33.3",
    "@tanstack/react-pacer": "^0.22.1",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.34",
    "@tanstack/router-plugin": "^1.168.23",
    "better-auth": "^1.6.25",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^1.28.0",
    "nanoid": "^6.0.0",
    "postgres": "^3.4.9",
    "posthog-js": "^1.409.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^4.1.3",
    "react-modal-sheet": "^5.6.0",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@std/csv": "jsr:^1.0.6",
    "@std/fs": "jsr:^1.0.24",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-seed": "^0.3.1",
    "oxfmt": "^0.61.0",
    "oxlint": "1.76.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "wrangler": "^4.118.0"
  },
  "packageManager": "pnpm@11.12.0"
}
