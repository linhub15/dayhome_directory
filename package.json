{
  "name": "discover_care",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.8",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "drizzle": "drizzle-kit",
    "data:load": "tsx ./data/load.ts",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "tsc": "tsc",
    "ci": "pnpm lint && pnpm tsc && pnpm build",
    "db:up": "docker compose up -d --wait postgres",
    "db:status": "docker compose ps --format 'table {{.Service}}\t{{.Status}}\t{{.Ports}}'",
    "db:down": "docker compose down",
    "db:seed": "tsx scripts/seed_db/main.ts",
    "auth:gen-schema": "pnpx @better-auth/cli generate --config ./src/lib/auth/better_auth.ts --output ./src/lib/auth/auth_schema.gen.ts"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.36.0",
    "@mapbox/search-js-core": "^1.5.1",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toggle": "^1.1.10",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/react-form": "^1.29.1",
    "@tanstack/react-pacer": "^0.22.0",
    "@tanstack/react-query": "^5.100.9",
    "@tanstack/react-router": "^1.169.2",
    "@tanstack/react-router-ssr-query": "^1.166.12",
    "@tanstack/react-start": "^1.167.64",
    "@tanstack/router-plugin": "^1.167.34",
    "better-auth": "^1.6.9",
    "clsx": "^2.1.1",
    "cva": "1.0.0-beta.4",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^1.14.0",
    "nanoid": "^5.1.11",
    "postgres": "^3.4.9",
    "posthog-js": "^1.372.9",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^4.1.3",
    "react-modal-sheet": "^5.6.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@std/csv": "jsr:^1.0.6",
    "@std/fs": "jsr:^1.0.23",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-seed": "^0.3.1",
    "oxfmt": "^0.48.0",
    "oxlint": "1.63.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "wrangler": "^4.88.0"
  }
}
